# =============================================================================
# Sensus Perfume — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# On Vercel: add these as Environment Variables in the project dashboard.
# =============================================================================

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sensus-perfumes?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Secret key for signing JWT tokens — use a long random string in production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ── Node Environment ──────────────────────────────────────────────────────────
NODE_ENV=production

# ── SMTP (Email) ─────────────────────────────────────────────────────────────
# Used for: order confirmations, password reset codes, newsletter welcome emails
SMTP_HOST=mail.sensusperfume.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@sensusperfume.com
SMTP_PASS=your-smtp-password
FROM_EMAIL=Sensus Perfumes <no-reply@sensusperfume.com>

# ── Admin Notifications ───────────────────────────────────────────────────────
# Email address that receives new order notifications
ORDER_NOTIFY_EMAIL=sensusperfume@gmail.com

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Meta Pixel ID for Facebook tracking
VITE_META_PIXEL_ID=your-meta-pixel-id

# API URL override — LEAVE EMPTY for Vercel production (uses relative /api).
# For local development: set to http://localhost:5000/api
# VITE_API_URL=
